{
  "name": "rigid-ui-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run demo#dev",
    "build": "vp pack",
    "build:site": "vp build",
    "format": "vp fmt .",
    "test": "VITEST_ENV=jsdom vp -C packages/rigid-ui test",
    "test:run": "VITEST_ENV=jsdom vp -C packages/rigid-ui test --run",
    "test:chromium": "VITEST_ENV=chromium vp -C packages/rigid-ui test --run",
    "ready": "vp check && vp run -r test && vp run -r build",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.22.0"
}
