{
  "name": "rigid-ui-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run demo#dev",
    "build": "vp run rigid-ui#build",
    "build:site": "vp run demo#build",
    "format": "vp fmt .",
    "test": "vp run rigid-ui#test",
    "test:run": "vp run rigid-ui#test:run",
    "test:chromium": "vp run rigid-ui#test:chromium",
    "ready": "vp run rigid-ui#build && vp check && vp run rigid-ui#test:run && vp run rigid-ui#test:chromium && vp run demo#build && vp run demo#test:docs",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.22.0"
}
